{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SymbolSweep",
  "version": "2.1.0",
  "identifier": "com.mvarley07.symbolsweep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SymbolSweep",
        "label": "main",
        "width": 280,
        "height": 300,
        "minWidth": 280,
        "minHeight": 200,
        "maxWidth": 280,
        "maxHeight": 580,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: Siren Group LLC (BT488C7R9Z)",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://licenses-seven.vercel.app/api/updater/symbolsweep"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNjFENzE2NDNBQ0MyMzIKUldReXdxeERGdGRoWXlPaFk1K2N3QmVCdEtUNitTcXZCNGtxZ3NNQVBRc0dHYTdLOXQrVzdoUm4K"
    }
  }
}